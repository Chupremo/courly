{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/features",
      "destination": "/features.html"
    },
    {
      "source": "/pricing",
      "destination": "/pricing.html"
    },
    {
      "source": "/clubs",
      "destination": "/clubs.html"
    },
    {
      "source": "/courts",
      "destination": "/courts.html"
    },
    {
      "source": "/owner-portal",
      "destination": "/owner-portal.html"
    }
  ]
}