{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "courtly",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "keep_vars": true,
  "previews": {
    "vars": {
      "COURTLY_EMAIL_ENABLED": "false",
      "COURTLY_SCHEDULED_JOBS_ENABLED": "false"
    }
  },
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/api", "/api/*", "/player/*", "/coach/*", "/club/*", "/v/*"]
  },
  // Enable these only at production cutover; see CLOUDFLARE.md.
  "triggers": { "crons": [] }
}
