{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/cron/send-billing-emails.js": {
      "maxDuration": 60
    },
    "api/notifications/process.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/court-owner",
      "destination": "/business.html"
    },
    {
      "source": "/help",
      "destination": "/help.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/admin-support",
      "destination": "/admin-support.html"
    },
    {
      "source": "/forgot-password",
      "destination": "/forgot-password.html"
    },
    {
      "source": "/reset-password",
      "destination": "/reset-password.html"
    },
    {
      "source": "/player/messages",
      "destination": "/player-messages.html"
    },
    {
      "source": "/demo",
      "destination": "/demo.html"
    },
    {
      "source": "/browse-clubs",
      "destination": "/browse-clubs.html"
    },
    {
      "source": "/club/dashboard",
      "destination": "/club-dashboard.html"
    },
    {
      "source": "/club/register",
      "destination": "/club-register.html"
    },
    {
      "source": "/club/login",
      "destination": "/club-login.html"
    },
    {
      "source": "/coaches",
      "destination": "/coaches.html"
    },
    {
      "source": "/coach/login",
      "destination": "/coach-login.html"
    },
    {
      "source": "/coach/register",
      "destination": "/coach-register.html"
    },
    {
      "source": "/coach/dashboard",
      "destination": "/coach-portal.html"
    },
    {
      "source": "/coach/booking",
      "destination": "/coach-booking.html"
    },
    {
      "source": "/coach/chat",
      "destination": "/coach-chat.html"
    },
    {
      "source": "/coach/:slug",
      "destination": "/coach.html?slug=:slug"
    },
    {
      "source": "/coach-terms",
      "destination": "/coach-owner-terms.html"
    },
    {
      "source": "/admin-coaches",
      "destination": "/admin-coaches.html"
    },
    {
      "source": "/my-coaching-sessions",
      "destination": "/my-coaching-sessions.html"
    },
    {
      "source": "/players",
      "destination": "/players.html"
    },
    {
      "source": "/venue-owner-terms",
      "destination": "/venue-owner-terms.html"
    },
    {
      "source": "/admin-billing",
      "destination": "/admin-billing.html"
    },
    {
      "source": "/player/register",
      "destination": "/player-register.html"
    },
    {
      "source": "/player/login",
      "destination": "/player-login.html"
    },
    {
      "source": "/player/dashboard/:view",
      "destination": "/player-dashboard.html?view=:view"
    },
    {
      "source": "/player/dashboard",
      "destination": "/player-dashboard.html?view=home"
    },
    {
      "source": "/features",
      "destination": "/features.html"
    },
    {
      "source": "/pricing",
      "destination": "/pricing.html"
    },
    {
      "source": "/clubs",
      "destination": "/clubs.html"
    },
    {
      "source": "/courts",
      "destination": "/courts.html"
    },
    {
      "source": "/owner-portal",
      "destination": "/owner-portal.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/book/:slug",
      "destination": "/venue.html?slug=:slug"
    },
    {
      "source": "/v/:slug",
      "destination": "/venue.html?slug=:slug"
    },
    {
      "source": "/booking-confirmation",
      "destination": "/booking-confirmation.html"
    },
    {
      "source": "/my-bookings",
      "destination": "/my-bookings.html"
    },
    {
      "source": "/community",
      "destination": "/community.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/send-billing-emails",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/notifications/process",
      "schedule": "0 3 * * *"
    }
  ]
}
