{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/features", "destination": "/features.html" },
    { "source": "/pricing", "destination": "/pricing.html" },
    { "source": "/clubs", "destination": "/clubs.html" },
    { "source": "/courts", "destination": "/courts.html" },
    { "source": "/owner-portal", "destination": "/owner-portal.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/v/:slug", "destination": "/venue.html?slug=:slug" }
  ]
}
