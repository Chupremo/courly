{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/players",
      "destination": "/players.html"
    },
    {
      "source": "/venue-owner-terms",
      "destination": "/venue-owner-terms.html"
    },
    {
      "source": "/admin-billing",
      "destination": "/admin-billing.html"
    },
    {
      "source": "/player/register",
      "destination": "/player-register.html"
    },
    {
      "source": "/player/login",
      "destination": "/player-login.html"
    },
    {
      "source": "/player/dashboard/:view",
      "destination": "/player-dashboard.html?view=:view"
    },
    {
      "source": "/player/dashboard",
      "destination": "/player-dashboard.html?view=home"
    },
    {
      "source": "/features",
      "destination": "/features.html"
    },
    {
      "source": "/pricing",
      "destination": "/pricing.html"
    },
    {
      "source": "/clubs",
      "destination": "/clubs.html"
    },
    {
      "source": "/courts",
      "destination": "/courts.html"
    },
    {
      "source": "/owner-portal",
      "destination": "/owner-portal.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/v/:slug",
      "destination": "/venue.html?slug=:slug"
    },
    {
      "source": "/booking-confirmation",
      "destination": "/booking-confirmation.html"
    },
    {
      "source": "/my-bookings",
      "destination": "/my-bookings.html"
    },
    {
      "source": "/community",
      "destination": "/community.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/send-billing-emails",
      "schedule": "0 2 * * *"
    }
  ]
}
