{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "courtly",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "keep_vars": true,
  "routes": [
    {
      "pattern": "www.courtlyph.com",
      "custom_domain": true
    }
  ],
  "previews": {
    "vars": {
      "COURTLY_EMAIL_ENABLED": "false",
      "COURTLY_SCHEDULED_JOBS_ENABLED": "false"
    }
  },
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": [
      "/api", "/api/*", "/player/*", "/coach/*", "/club/*", "/v/*",
      "/", "/index.html",
      "/business", "/business/", "/business.html",
      "/players", "/players/", "/players.html",
      "/player-register", "/player-register/", "/player-register.html",
      "/coaches", "/coaches/", "/coaches.html",
      "/coach-register", "/coach-register/", "/coach-register.html",
      "/coach", "/coach.html",
      "/coach-booking", "/coach-booking/", "/coach-booking.html",
      "/venue", "/venue/", "/venue.html",
      "/clubs", "/clubs/", "/clubs.html",
      "/community", "/community/", "/community.html",
      "/community-event", "/community-event/", "/community-event.html"
    ]
  },
  // Scheduled jobs stay disabled until the Vercel scheduler is deliberately retired.
  "triggers": { "crons": [] }
}
